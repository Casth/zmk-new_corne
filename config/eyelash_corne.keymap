#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// Layer definition
#define WIN    0
#define MAC    1
#define SYM    2
#define NWIN   3
#define NMAC   4
#define FUN    5

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

   combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;  // Q + S + Z
        };
    };

    macros {
        lwin: lang_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_press &kp LALT>
                , <&macro_wait_time 200>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LALT>
                ;
        };

        lmac: lang_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LALT>
                , <&macro_press &kp SPACE>
                , <&macro_wait_time 100>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LALT>
                , <&macro_release &kp SPACE>
                ;
        };

        lmact: lang_mac_term {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LALT>
                , <&macro_press &kp SPACE>
                , <&macro_wait_time 100>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LALT>
                , <&macro_release &kp SPACE>
                ;
        };

        emoj: emoji_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                , <&macro_press &kp SPACE>
                , <&macro_wait_time 100>
                , <&macro_release &kp LGUI>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp SPACE>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // 0: WIN
            display-name = "Win";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │     Caps     │       Q      │    W (Alt)   │       E      │       R      │       T      │                                           │       Y      │       U      │       I      │       O      │       P      │       [      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      &kp CAPS         &kp Q        &mt LALT W        &kp E          &kp R          &kp T                      &kp UP                          &kp Y          &kp U          &kp I          &kp O          &kp P        &kp LBKT
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │    LShift    │   A (LGui)   │       S      │  D (LCtrl)   │  F (LShift)  │       G      │                                           │       H      │  J (RShift)  │  K (LCtrl)   │       L      │   ; (RGui)   │       '      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      &kp LSHFT      &mt LGUI A        &kp S       &mt LCTRL D    &mt LSHFT F       &kp G            &kp LEFT  &kp ENTER  &kp RIGHT            &kp H       &mt RSHFT J    &mt LCTRL K       &kp L      &mt RGUI SEMI     &kp SQT
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │    LCtrl     │       Z      │       X      │       C      │       V      │       B      │                                           │       N      │       M      │       ,      │       .      │       /      │   # (Ctrl)   │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
      &kp LCTRL        &kp Z           &kp X          &kp C          &kp V          &kp B        &kp SPACE     &kp DOWN                        &kp N          &kp M        &kp COMMA       &kp DOT        &kp FSLH   &mt LCTRL NUHS
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │  Esc (FUN)   │  Bksp (NWIN) │  Enter (SYM) │                                           │  Space (SYM) │   Tab (NWIN) │   Del (FUN)  │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                  &lt FUN ESC   &lt NWIN BSPC    &lt SYM RET                                              &lt SYM SPACE   &lt NWIN TAB   &lt FUN DEL
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        mac_layer { // 1: MAC
            display-name = "Mac";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &trans         &trans         &trans         &trans         &trans                      &trans                         &trans         &trans         &trans         &trans         &trans         &trans
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │   A (LCtrl)  │       ⌄      │   D (LGui)   │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │   K (LGui)   │       ⌄      │   ; (RCtrl)  │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans      &mt LCTRL A       &trans       &mt LGUI D       &trans         &trans             &trans   &trans   &trans                &trans         &trans       &mt LGUI K       &trans     &mt RCTRL SEMI     &trans
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &trans         &trans         &trans         &trans         &trans        &trans        &trans                         &trans         &trans         &trans         &trans         &trans         &trans
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │       ⌄      │  Bksp (NMAC) │       ⌄      │                                           │       ⌄      │  Tab (NMAC)  │       ⌄      │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                     &trans     &lt NMAC BSPC      &trans                                                     &trans      &lt NMAC TAB      &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        symbol_layer { // 2: SYM
            display-name = "Symbol";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       ⌄      │       *      │       {      │       }      │       |      │                                           │       '      │       ?      │       +      │       =      │       #      │    (none)    │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &trans        &kp STAR       &kp LBRC       &kp RBRC       &kp PIPE                      &trans                        &kp SQT      &kp QMARK       &kp PLUS       &kp EQUAL      &kp POUND        &none
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ^      │       `      │       %      │       (      │       )      │       &      │                                           │       "      │       _      │       -      │       /      │       :      │       $      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
       &kp CARET     &kp GRAVE      &kp PRCNT       &kp LPAR       &kp RPAR       &kp AMPS            &trans   &trans   &trans               &kp DQT      &kp UNDER       &kp MINUS      &kp FSLH       &kp COLON      &kp DLLR
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │     menu     │       ⌄      │       ~      │       [      │       ]      │       @      │                                           │       \      │       !      │       <      │       >      │    (emoji)   │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
     &kp K_CMENU       &trans       &kp TILDE       &kp LBKT       &kp RBKT        &kp AT        &trans        &trans                        &kp BSLH       &kp EXCL        &kp LT         &kp GT          &emoj         &trans
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                     &trans         &trans         &trans                                                     &trans         &trans         &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        num_win_layer { // 3: NWIN
            display-name = "Number";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       0      │       9      │       8      │       7      │       6      │                                           │     home     │   page down  │    page up   │      end     │    (none)    │    (none)    │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &kp N0         &kp N9         &kp N8         &kp N7         &kp N6                      &trans                        &kp HOME      &kp PG_DN      &kp PG_UP        &kp END         &none          &none
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       1      │       2      │       3      │       4      │       5      │                                           │     left     │      down    │      up      │     right    │     RGui     │    (none)    │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &kp N1         &kp N2         &kp N3         &kp N4         &kp N5              &trans   &trans   &trans               &kp LEFT      &kp DOWN        &kp UP        &kp RIGHT      &kp RGUI         &none
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │     undo     │      cut     │     copy     │     paste    │     redo     │                                           │ lang mac ter │   lang mac   │   lang win   │    (none)    │    (none)    │    (none)    │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans        &kp LC(Z)      &kp LC(X)      &kp LC(C)      &kp LC(V)      &kp LC(Y)      &trans        &trans                         &lmact          &lmac          &lwin          &none          &none          &none
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                     &trans         &trans         &trans                                                     &trans         &trans         &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        num_mac_layer { // 4: NMAC
            display-name = "Number";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &trans         &trans         &trans         &trans         &trans                      &trans                         &trans         &trans         &trans         &trans         &trans         &trans
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans         &trans         &trans         &trans         &trans         &trans             &trans   &trans   &trans                &trans         &trans         &trans         &trans         &trans         &trans
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │       ⌄      │     undo     │      cut     │     copy     │     paste    │     redo     │                                           │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │       ⌄      │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &trans        &kp LG(Z)      &kp LG(X)      &kp LG(C)      &kp LG(V)      &kp LG(Y)      &trans        &trans                         &trans         &trans         &trans         &trans         &trans         &trans
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                     &trans         &trans         &trans                                                     &trans         &trans         &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        function_layer { // 5: FUN
            display-name = "Function";
            bindings = <
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │      F11     │      F10     │      F9      │      F8      │      F7      │      F6      │                                           │    (none)    │    (none)    │  Mac layout  │  Win layout  │    (none)    │  bootloader  │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &kp F11       &kp F10         &kp F9         &kp F8         &kp F7         &kp F6                      &trans                          &none          &none        &tog MAC       &tog WIN         &none       &bootloader
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │      F12     │      F1      │      F2      │      F3      │      F4      │      F5      │                                           │    (none)    │    (none)    │    (none)    │    (none)    │    (none)    │    (none)    │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &kp F12        &kp F1         &kp F2         &kp F3         &kp F4         &kp F5              &trans   &trans   &trans                &none          &none          &none          &none          &none          &none
// ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────┐
// │    (none)    │    (none)    │     vol -    │     mute     │     vol +    │    (none)    │                                           │     BT 0     │     BT 1     │     BT 2     │     BT 3     │     BT 4     │   BT clear   │
// └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┴──────────────┴──────────────┴──────────────┘
        &none          &none      &kp C_VOL_DN     &kp C_MUTE    &kp C_VOL_UP       &none        &trans        &trans                      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4    &bt BT_CLR
//                                              ┌──────────────┬──────────────┬──────────────┐                                           ┌──────────────┬──────────────┬──────────────┐
//                                              │       ⌄      │       ⌄      │       ⌄      │                                           │       ⌄      │       ⌄      │       ⌄      │
//                                              └──────────────┴──────────────┴──────────────┘                                           └──────────────┴──────────────┴──────────────┘
                                                     &trans         &trans         &trans                                                     &trans         &trans         &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
